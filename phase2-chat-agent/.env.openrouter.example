# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter Configuration Example (OpenAI-compatible)
# Copy to .env.local and replace with your actual API key
# ─────────────────────────────────────────────────────────────────────────────

# Using generic LLM_* variables (recommended)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Or using LM_STUDIO_* variables for backward compatibility
# LM_STUDIO_BASE_URL=https://openrouter.ai/api/v1
# LM_STUDIO_API_KEY=sk-or-v1-your-key-here
# LM_STUDIO_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Kubernetes (kind) ───────────────────────────────────────────────────────
KUBE_CONTEXT=kind-my-cluster
KUBE_NAMESPACE=default
KUBECTL_BIN=kubectl
KUBECTL_TIMEOUT_MS=30000
KUBECTL_RETRIES=1

# ── Agent behaviour ─────────────────────────────────────────────────────────
USE_REAL_CLUSTER=true
AGENT_MAX_STEPS=15

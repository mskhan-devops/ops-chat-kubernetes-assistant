# ─────────────────────────────────────────────────────────────────────────────
# Local Ops Chat — configuration
# Copy to .env.local  (Next.js loads .env.local automatically):
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (OpenAI-compatible) ────────────────────────────────────────
# Supports any OpenAI-compatible endpoint (LM Studio, OpenRouter, Groq, etc.)
# Use generic LLM_* vars or LM_STUDIO_* vars for backward compatibility
LLM_BASE_URL=http://127.0.0.1:9931/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model
# LLM_PROVIDER_NAME=openai-compatible

# For OpenRouter (example):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# For Groq (example):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-key-here
# LLM_MODEL=llama-3.1-8b-instant

# Backward compatible LM Studio vars (also supported):
# LM_STUDIO_BASE_URL=http://127.0.0.1:9931/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=local-model

# ── Local Kubernetes (kind) ──────────────────────────────────────────────────
KUBE_CONTEXT=kind-my-cluster
KUBE_NAMESPACE=default
KUBECTL_BIN=kubectl
# Max time a single kubectl call may run before it is killed (ms). Keep this
# small so a hung API server never freezes a turn.
KUBECTL_TIMEOUT_MS=30000
# Retry a kubectl call once on transient connection failures (0 disables).
KUBECTL_RETRIES=1

# ── Agent behaviour ──────────────────────────────────────────────────────────
USE_REAL_CLUSTER=true
# Upper bound on model/tool rounds per turn. Lower keeps the local model from
# rambling; raise for long multi-step workflows.
AGENT_MAX_STEPS=15

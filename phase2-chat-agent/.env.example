# ─────────────────────────────────────────────────────────────────────────────
# Local Ops Chat — configuration
# Copy to .env.local  (Next.js loads .env.local automatically):
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Local LLM: LM Studio (OpenAI-compatible server) ──────────────────────────
LM_STUDIO_BASE_URL=http://127.0.0.1:9931/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=local-model

# ── Local Kubernetes (kind) ──────────────────────────────────────────────────
KUBE_CONTEXT=kind-my-cluster
KUBE_NAMESPACE=default
KUBECTL_BIN=kubectl
# Max time a single kubectl call may run before it is killed (ms). Keep this
# small so a hung API server never freezes a turn.
KUBECTL_TIMEOUT_MS=30000
# Retry a kubectl call once on transient connection failures (0 disables).
KUBECTL_RETRIES=1

# ── Agent behaviour ──────────────────────────────────────────────────────────
USE_REAL_CLUSTER=true
# Upper bound on model/tool rounds per turn. Lower keeps the local model from
# rambling; raise for long multi-step workflows.
AGENT_MAX_STEPS=15
